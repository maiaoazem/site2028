{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ctxt-humano-bionico",
  "main": "./worker.js",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "vars": {
    "RETENTION_DAYS": "180"
  },
  "triggers": {
    "crons": ["0 3 * * *"]
  }
}
